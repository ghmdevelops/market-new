# Firebase (Console > Configurações do projeto > Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database > Dados (copie a URL exata, pode ter sufixo de região)
VITE_FIREBASE_DATABASE_URL=

# URL pública usada nas meta tags de SEO/compartilhamento.
# No Netlify NÃO precisa definir: ele expõe a variável URL automaticamente no build.
VITE_SITE_URL=http://localhost:5173
